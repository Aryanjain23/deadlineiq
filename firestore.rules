rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Registered users directory for email existence check
    match /registeredUsers/{emailKey} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // User profile document and all nested collections
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Daily plans
      match /dailyPlans/{planId} {
        allow read, write: if isOwner(uid);
      }

      // Academic deadlines
      match /deadlines/{deadlineId} {
        allow read, write: if isOwner(uid);
      }

      // Timetable classes
      match /timetable/{timetableId} {
        allow read, write: if isOwner(uid);
      }

      // Exams
      match /exams/{examId} {
        allow read, write: if isOwner(uid);
      }

      // Events
      match /events/{eventId} {
        allow read, write: if isOwner(uid);
      }

      // Settings
      match /settings/{settingId} {
        allow read, write: if isOwner(uid);
      }

      // Sources
      match /sources/{sourceId} {
        allow read, write: if isOwner(uid);
      }

      // Notification tokens
      match /notificationTokens/{tokenId} {
        allow read, write: if isOwner(uid);
      }

      // Recursive fallback for any nested document under user
      match /{allSubcollections=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Top-level direct path fallback for any subcollection under users
    match /users/{uid}/{collectionId}/{docId} {
      allow read, write: if isOwner(uid);
    }
  }
}

